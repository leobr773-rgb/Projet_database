// ══════════════════════════════════════════════════════════════════════════════
//  ICT Backtest Strategy — BTC/USD PropFirm Challenge
//  Setups : FVG Retest + Liquidity Sweep
//  Sessions : London Open (09h-11h UTC+2) + New York (14h30-17h UTC+2)
//  Risk : 1% par trade | RR : 2:1 minimum
//  Timeframe recommandé : 15min (entrée) avec bias H4
// ══════════════════════════════════════════════════════════════════════════════
//@version=5
strategy(
  title       = "ICT PropFirm — FVG + Liquidity Sweep",
  shorttitle  = "ICT_PF",
  overlay     = true,
  default_qty_type  = strategy.percent_of_equity,
  default_qty_value = 1,
  initial_capital   = 10000,
  commission_type   = strategy.commission.percent,
  commission_value  = 0.1,
  slippage          = 2,
  calc_on_order_fills = false,
  process_orders_on_close = false
)

// ── PARAMÈTRES ──────────────────────────────────────────────────────────────
var g_risk   = "Risk Management"
riskPct      = input.float(1.0,  "Risque par trade (%)",     minval=0.1, maxval=5.0, step=0.1, group=g_risk)
rrTarget     = input.float(2.0,  "Risk/Reward cible",        minval=1.0, maxval=10.0, step=0.1, group=g_risk)
feePct       = input.float(0.1,  "Frais aller-retour (%)",   minval=0.0, maxval=1.0,  step=0.05, group=g_risk)

var g_setup  = "Setups ICT"
fvgMinSize   = input.float(0.05, "FVG taille minimum (%)",   minval=0.01, maxval=1.0, step=0.01, group=g_setup, tooltip="Taille minimale du gap en % du prix")
lsLookback   = input.int(20,     "Lookback Liquidity Sweep", minval=5,   maxval=100,  group=g_setup, tooltip="Nombre de bougies pour identifier le swing high/low à sweeper")
useFVG       = input.bool(true,  "Activer FVG Retest",       group=g_setup)
useLS        = input.bool(true,  "Activer Liquidity Sweep",  group=g_setup)

var g_bias   = "Bias & Filtre"
biasEmaLen   = input.int(50,     "EMA Bias (période)",       minval=10, maxval=200, group=g_bias)
useH4Bias    = input.bool(true,  "Filtre bias EMA",          group=g_bias, tooltip="Long uniquement si prix > EMA, Short si prix < EMA")
useSessions  = input.bool(true,  "Filtre sessions (LDN/NY)",  group=g_bias)

var g_ui     = "Affichage"
showFVG      = input.bool(true,  "Afficher les FVG",         group=g_ui)
showLS       = input.bool(true,  "Afficher les Sweeps",      group=g_ui)
showBias     = input.bool(true,  "Afficher EMA Bias",        group=g_ui)

// ── TIMEZONE & SESSIONS ─────────────────────────────────────────────────────
// UTC+2 (heure Paris été) — London 07h-09h UTC / New York 12h30-15h UTC
londonSession = time(timeframe.period, "0700-0900:23456")   // Lun-Ven
nySession     = time(timeframe.period, "1230-1500:23456")
nyPmSession   = time(timeframe.period, "1700-1900:23456")

inSession = useSessions ? (not na(londonSession) or not na(nySession)) : true

// ── BIAS EMA ────────────────────────────────────────────────────────────────
biasEma  = ta.ema(close, biasEmaLen)
bullBias = close > biasEma
bearBias = close < biasEma

plot(showBias ? biasEma : na, "EMA Bias", color=bullBias ? color.new(color.teal, 30) : color.new(color.red, 30), linewidth=2)

// ── DÉTECTION FVG (Fair Value Gap) ──────────────────────────────────────────
// Bullish FVG : low[0] > high[2] → gap entre high[2] et low[0]
// Bearish FVG : high[0] < low[2] → gap entre low[2] et high[0]

fvgMinPts = close * fvgMinSize / 100

bullFVG   = low  > high[2] and (low - high[2]) >= fvgMinPts
bearFVG   = high < low[2]  and (low[2] - high) >= fvgMinPts

// Mémoriser les FVG actifs (top, bottom)
var float bFVG_top = na
var float bFVG_bot = na
var float bFVG_mid = na
var int   bFVG_bar = na
var float sFVG_top = na
var float sFVG_bot = na
var float sFVG_mid = na
var int   sFVG_bar = na

if bullFVG
    bFVG_bot := high[2]
    bFVG_top := low
    bFVG_mid := (bFVG_bot + bFVG_top) / 2
    bFVG_bar := bar_index

if bearFVG
    sFVG_top := low[2]
    sFVG_bot := high
    sFVG_mid := (sFVG_top + sFVG_bot) / 2
    sFVG_bar := bar_index

// Retest dans le FVG (prix revient toucher la zone)
inBullFVG = not na(bFVG_bot) and low <= bFVG_top and close >= bFVG_bot and bar_index > bFVG_bar
inBearFVG = not na(sFVG_bot) and high >= sFVG_bot and close <= sFVG_top and bar_index > sFVG_bar

// Affichage FVG
plotshape(showFVG and bullFVG, "Bull FVG", shape.triangleup,   location.belowbar, color.new(color.teal, 60), size=size.tiny)
plotshape(showFVG and bearFVG, "Bear FVG", shape.triangledown, location.abovebar, color.new(color.red,  60), size=size.tiny)

// ── DÉTECTION LIQUIDITY SWEEP ────────────────────────────────────────────────
// Sweep haussier : le prix casse le plus haut des N dernières bougies puis revient sous
// Sweep baissier : le prix casse le plus bas des N dernières bougies puis revient au-dessus

swingHigh = ta.highest(high, lsLookback)[1]
swingLow  = ta.lowest(low,  lsLookback)[1]

// Sweep : wick franchit le niveau, close revient de l'autre côté
bullSweep = high > swingHigh and close < swingHigh   // sweep du high + rejection baissière → potential reversal court
bearSweep = low  < swingLow  and close > swingLow    // sweep du low  + rejection haussière → potential reversal long

plotshape(showLS and bearSweep, "Bear Sweep (Buy Signal)", shape.circle, location.belowbar, color.new(color.green, 40), size=size.small)
plotshape(showLS and bullSweep, "Bull Sweep (Sell Signal)", shape.circle, location.abovebar, color.new(color.red,   40), size=size.small)

// ── SIGNAUX D'ENTRÉE ─────────────────────────────────────────────────────────
// LONG  : Bearish Liquidity Sweep (sweep du low) OU Bullish FVG Retest + bias haussier + session active
// SHORT : Bullish Liquidity Sweep (sweep du high) OU Bearish FVG Retest + bias baissier + session active

longSignalLS  = useLS  and bearSweep and (not useH4Bias or bullBias) and inSession
longSignalFVG = useFVG and inBullFVG and (not useH4Bias or bullBias) and inSession
shortSignalLS  = useLS  and bullSweep and (not useH4Bias or bearBias) and inSession
shortSignalFVG = useFVG and inBearFVG and (not useH4Bias or bearBias) and inSession

longSignal  = (longSignalLS  or longSignalFVG)  and strategy.position_size == 0
shortSignal = (shortSignalLS or shortSignalFVG) and strategy.position_size == 0

// ── CALCUL SL / TP ───────────────────────────────────────────────────────────
// SL : sous le swing low récent (long) / au-dessus swing high récent (short)
// TP : SL distance × RR

atr       = ta.atr(14)
slBuffer  = atr * 0.5   // buffer ATR pour éviter les faux déclenchements

longSL    = ta.lowest(low, 5) - slBuffer
longTP    = close + (close - longSL) * rrTarget
shortSL   = ta.highest(high, 5) + slBuffer
shortTP   = close - (shortSL - close) * rrTarget

// ── EXÉCUTION DES ORDRES ─────────────────────────────────────────────────────
// Le sizing 1% est géré par default_qty_type = percent_of_equity

if longSignal
    strategy.entry("Long", strategy.long, comment=longSignalLS ? "LS" : "FVG")
    strategy.exit("Long Exit", "Long", stop=longSL, limit=longTP)

if shortSignal
    strategy.entry("Short", strategy.short, comment=shortSignalLS ? "LS" : "FVG")
    strategy.exit("Short Exit", "Short", stop=shortSL, limit=shortTP)

// ── MARQUEURS ENTRÉE/SORTIE ──────────────────────────────────────────────────
plotshape(longSignal,  "Long Entry",  shape.arrowup,   location.belowbar, color.green, size=size.normal)
plotshape(shortSignal, "Short Entry", shape.arrowdown, location.abovebar, color.red,   size=size.normal)

// ── DASHBOARD STATS ──────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 9,
  bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.white, 80),
  frame_color=color.new(color.white, 60), frame_width=1)

f_cell(col, row, txt, val, col_val) =>
    table.cell(dash, col, row, txt,  text_color=color.new(color.white, 30), text_size=size.small)
    table.cell(dash, col+1 > 1 ? 0 : 1, row, val, text_color=col_val, text_size=size.small, text_halign=text.align_right)

netProfit   = strategy.netprofit
totalTrades = strategy.closedtrades
wins        = strategy.wintrades
losses      = strategy.losstrades
winRate     = totalTrades > 0 ? wins / totalTrades * 100 : 0.0
avgWin      = strategy.wintrades > 0 ? strategy.grossprofit / strategy.wintrades : 0.0
avgLoss     = strategy.losstrades > 0 ? math.abs(strategy.grossloss / strategy.losstrades) : 0.0
pfactor     = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0
maxDD       = strategy.max_drawdown

if barstate.islast
    table.cell(dash, 0, 0, "📊 ICT Backtest",   text_color=color.yellow,  text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, 0, str.tostring(close, "#.##"), text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 1, "P&L Net",           text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 1, (netProfit >= 0 ? "+" : "") + str.tostring(netProfit, "#.##") + "$",
      text_color=netProfit >= 0 ? color.green : color.red, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 2, "Trades",             text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(totalTrades) + " (" + str.tostring(wins) + "W / " + str.tostring(losses) + "L)",
      text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 3, "Win Rate",           text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(winRate, "#.1") + "%",
      text_color=winRate >= 60 ? color.green : winRate >= 50 ? color.yellow : color.red, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 4, "Profit Factor",      text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(pfactor, "#.##"),
      text_color=pfactor >= 1.5 ? color.green : pfactor >= 1.0 ? color.yellow : color.red, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 5, "Avg Win / Loss",     text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 5, "+" + str.tostring(avgWin, "#.##") + "$ / -" + str.tostring(avgLoss, "#.##") + "$",
      text_color=color.white, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 6, "Max Drawdown",       text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 6, "-" + str.tostring(maxDD, "#.##") + "$",
      text_color=maxDD > 600 ? color.red : maxDD > 300 ? color.yellow : color.green, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 7, "Risque / RR",        text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(riskPct) + "% / 1:" + str.tostring(rrTarget),
      text_color=color.teal, text_size=size.small, text_halign=text.align_right)

    table.cell(dash, 0, 8, "Session filtre",     text_color=color.new(color.white,30), text_size=size.small)
    table.cell(dash, 1, 8, useSessions ? "LDN + NY" : "Toutes",
      text_color=color.white, text_size=size.small, text_halign=text.align_right)

// ── FOND SESSIONS ────────────────────────────────────────────────────────────
bgcolor(not na(londonSession) ? color.new(color.blue,  95) : na, title="London Session")
bgcolor(not na(nySession)     ? color.new(color.green, 95) : na, title="New York Session")
