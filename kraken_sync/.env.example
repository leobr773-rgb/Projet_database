# Copiez ce fichier en ".env" (sans le ".example") et remplissez vos valeurs.
# Le fichier ".env" est ignoré par git (.gitignore) -> vos clés ne seront jamais commitées.

# "kraken"        = Kraken Spot/Pro (compte spot, marge)
# "krakenfutures" = Kraken Futures (compte "Contract Future")
KRAKEN_EXCHANGE=kraken

# Créez une clé API en lecture seule sur Kraken :
#  - Kraken Pro (spot)   : https://pro.kraken.com/app/settings/api  -> permissions "Query Funds", "Query Open/Closed Orders & Trades", "Query Ledger Entries"
#  - Kraken Futures      : https://futures.kraken.com/  (Settings > API Keys) -> permission "Read only" (general + fills)
# NE COCHEZ JAMAIS "Withdraw" / "Trade" -- lecture seule uniquement.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Solde de départ du compte (le 1er jour, avant le 1er trade), utilisé comme
# point de référence pour la courbe de capital. Ex: 23.57
KRAKEN_STARTING_BALANCE=23.57

# Devise de référence du compte (pour filtrer les trades/ledger)
KRAKEN_QUOTE_CURRENCY=USD
